#!/usr/bin/env bash
# gstack-patch-names — patch name: field in SKILL.md frontmatter for prefix mode
# Usage: gstack-patch-names <gstack-dir> <true|false|1|0>
set -euo pipefail

GSTACK_DIR="$1"
DO_PREFIX="$2"

# Normalize prefix arg
case "$DO_PREFIX" in true|1) DO_PREFIX=1 ;; *) DO_PREFIX=0 ;; esac

# EO-Stack fork: the namespace written into the name: field. This is the value
# Claude Code actually registers as the slash command, so it MUST match the
# link name setup builds (setup: SKILL_NS) or you get eo-* directories that
# still register as /gstack-*.
NS="${EO_SKILL_NS:-eo-}"

PATCHED=0
for skill_dir in "$GSTACK_DIR"/*/; do
  [ -f "$skill_dir/SKILL.md" ] || continue
  dir_name="$(basename "$skill_dir")"
  [ "$dir_name" = "node_modules" ] && continue
  cur=$(grep -m1 '^name:' "$skill_dir/SKILL.md" 2>/dev/null | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]' || true)
  [ -z "$cur" ] && continue
  [ "$cur" = "gstack" ] && continue  # never prefix root skill
  if [ "$DO_PREFIX" -eq 1 ]; then
    case "$cur" in "$NS"*) continue ;; esac
    # A legacy gstack- name gets its prefix swapped, not stacked, matching the
    # link-name rule in setup: gstack-upgrade -> eo-upgrade.
    new="${NS}${cur#gstack-}"
  else
    case "$cur" in
      "$NS"*)   new="${cur#$NS}" ;;
      gstack-*) new="${cur#gstack-}" ;;
      *)        continue ;;
    esac
    [ "$dir_name" = "$cur" ] && continue  # inherently prefixed (gstack-upgrade)
  fi
  tmp="$(mktemp "${skill_dir}/SKILL.md.XXXXXX")"
  sed "1,/^---$/s/^name:[[:space:]]*${cur}/name: ${new}/" "$skill_dir/SKILL.md" > "$tmp" && mv "$tmp" "$skill_dir/SKILL.md"
  PATCHED=$((PATCHED + 1))
done
if [ "$PATCHED" -gt 0 ]; then
  echo "  patched name: field in $PATCHED skills"
fi
